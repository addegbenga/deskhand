{
  "name": "deskhand",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev-gateway.mjs --with-apps",
    "dev:tenant": "pnpm --filter @deskhand/tenant dev",
    "dev:admin": "pnpm --filter @deskhand/admin dev",
    "dev:public": "pnpm --filter @deskhand/public dev",
    "gateway": "node scripts/dev-gateway.mjs",
    "build": "pnpm -r --filter \"./apps/*\" build",
    "build:vercel": "pnpm build && node scripts/assemble-vercel.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write .",
    "storybook": "pnpm --filter @deskhand/ui storybook"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-i18next": "^6.1.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "http-proxy-3": "^2.0.1",
    "prettier": "^3.6.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0"
  }
}
